    "FieldDisplay": {
      "additionalProperties": false,
      "description": "Where the editor shows a field's value.",
      "properties": {
        "arrow": {
          "description": "entity_ref and point: draw an arrow to the target.",
          "type": "boolean"
        },
        "canvas": {
          "description": "Show the value next to the entity on the canvas.",
          "type": "boolean"
        },
        "world": {
          "description": "Show in the zoomed-out world view.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Slug": {
      "description": "snake_case name: a lowercase letter, then lowercase letters, digits or underscores.",
      "pattern": "^[a-z][a-z0-9_]*$",
      "type": "string"
    },
    "TypeTag": {
      "enum": [
        "int",
        "float",
        "bool",
        "string",
        "text",
        "color",
        "enum",
        "point",
        "entity_ref",
        "path",
        "tile",
