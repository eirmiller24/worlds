  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A whole project. The serialized part is `project.json`.",
  "properties": {
    "$schema": {
      "description": "Relative path to schema/project.json.",
      "type": "string"
    },
    "bg_color": {
      "anyOf": [
        {
          "$ref": "#/$defs/Color"
        },
        {
          "type": "null"
        }
      ],
      "description": "Default level background."
    },
    "blocking_values": {
      "description": "Values of the collision layer that block movement. The export's\n`open_edges` are the border cells holding anything else (empty\nincluded). `None` (left out of the file) is not the same as `[]`:\nloading fills an absent list from [`DEFAULT_BLOCKING_VALUES`] (see\n[`Project::default_blocking_values`]); `[]` means nothing blocks.",
      "items": {
        "$ref": "#/$defs/Slug"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "collision_layer": {
      "anyOf": [
        {
          "$ref": "#/$defs/Slug"
        },
        {
          "type": "null"
        }
      ],
      "description": "The `int_grid` layer whose values are the collision kinds. The game\nexport reads level `open_edges` from it; unset, there are none."
    },
    "default_level_size": {
      "description": "Size in cells of a level made with the editor's New Level command.\nUnset, the editor uses the most common level size in the project.",
      "items": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": [
        "array",
        "null"
      ]
    },
    "export_on_save": {
      "description": "The editor writes `export/` on every save (as `worlds-cli bake` does).",
      "type": "boolean"
    },
    "format": {
      "const": 1,
      "description": "File format version."
    },
    "grid_size": {
      "description": "Cell size in pixels. Level sizes and cell coordinates are in these cells.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "level_fields": {
      "description": "Fields every level has (values in each `level.json`).",
      "items": {
        "$ref": "#/$defs/FieldDef"
      },
      "type": "array"
    },
    "name": {
      "type": "string"
    },
    "seed": {
      "description": "Project-wide seed mixed into every rule's random choices.",
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "$schema",
    "format",
    "name",
    "grid_size",
    "seed"
  ],
  "title": "Worlds project file",
  "type": "object"
}
