              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "locked": {
              "description": "Not movable in the editor.",
              "type": "boolean"
            },
            "px": {
              "description": "note, pin (required): the point, in pixels.",
              "items": {
                "format": "int64",
                "type": "integer"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": [
                "array",
                "null"
              ]
            },
            "status": {
              "$ref": "#/$defs/NoteStatus"
