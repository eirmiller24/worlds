    },
    "Color": {
      "description": "Hex color, #rrggbb or #rrggbbaa.",
      "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
      "type": "string"
    },
    "ConnectorStyle": {
      "description": "How a connector is drawn: an arrow at `to` (the default), a plain line,\nor arrows at both ends.",
      "enum": [
        "arrow",
        "line",
        "double"
      ],
      "type": "string"
    },
    "Endpoint": {
      "description": "What a connector end is anchored to: `{ \"level\": slug }` or\n`{ \"entity\": id }`.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A level (room): the end sits on its edge.",
          "properties": {
            "level": {
              "$ref": "#/$defs/Slug"
            }
          },
          "required": [
            "level"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An entity instance: the end sits on its pivot.",
          "properties": {
            "entity": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "entity"
          ],
          "type": "object"
        }
      ]
    },
    "GuideGroup": {
      "additionalProperties": false,
      "description": "A named set of guides with its own offset: `world.json` `guide_groups`.\nGuides store their points as designed; the editor draws a grouped guide\nat `points + offset` (\"as built\") unless the view shows guides as designed.",
      "properties": {
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/Color"
            },
            {
              "type": "null"
            }
          ],
          "description": "Drawing color of the group's guides (over each guide's own)."
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "offset": {
          "description": "World pixels added to every point of the group's guides when shown as built.",
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "slug": {
          "$ref": "#/$defs/Slug"
        }
      },
      "required": [
        "slug"
      ],
      "type": "object"
    },
    "Id": {
      "description": "Instance id: 10 characters from a-z and 2-7.",
      "pattern": "^[a-z2-7]{10}$",
      "type": "string"
    },
    "KindTag": {
      "enum": [
        "note",
        "pin",
        "path",
        "region",
        "guide",
        "connector"
      ],
      "type": "string"
    },
    "LayoutMode": {
      "description": "How a world places its levels.",
      "oneOf": [
        {
          "const": "free",
          "description": "Levels go where they are put.",
          "type": "string"
        },
        {
          "const": "horizontal",
          "description": "Left to right in level order.",
          "type": "string"
        },
        {
          "const": "vertical",
          "description": "Top to bottom in level order.",
          "type": "string"
        },
        {
          "const": "grid_vania",
          "description": "Levels snap to a lattice and are whole lattice cells.",
          "type": "string"
        }
      ]
    },
    "NoteStatus": {
      "enum": [
        "open",
        "done"
      ],
      "type": "string"
    },
    "Reference": {
      "additionalProperties": false,
      "description": "One entry of `references` in `level.json` or `world.json`.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "image": {
          "description": "Path to the PNG, relative to the project directory,\n`/`-separated, like a tileset's `image`.",
          "type": "string"
        },
        "locked": {
          "description": "The editor's tools don't move or scale it. Default false.",
          "type": "boolean"
        },
        "opacity": {
          "description": "0 (invisible) to 1 (opaque). Default 1.",
          "format": "double",
          "type": "number"
        },
        "px": {
          "description": "Top-left corner in pixels: level pixels in `level.json`, world\npixels in `world.json`.",
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "scale": {
          "description": "Drawn size over the image's own size in pixels. Default 1.",
          "format": "double",
          "type": "number"
        },
        "visible": {
          "description": "Drawn at all. Default true.",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "image",
        "px"
      ],
      "type": "object"
    },
    "Slug": {
      "description": "snake_case name: a lowercase letter, then lowercase letters, digits or underscores.",
      "pattern": "^[a-z][a-z0-9_]*$",
      "type": "string"
    },
    "WorldLayout": {
      "additionalProperties": false,
      "description": "`world.json` `layout`. Left out of the file at its default (free, no\ngap, no cell).",
      "properties": {
        "cell": {
          "description": "Grid vania: the lattice cell `[w, h]` in pixels, a multiple of the\nproject grid. Default 16 project cells each way.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        },
        "gap": {
          "description": "Strip layouts: pixels between two neighbouring levels. Default 0.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "mode": {
          "$ref": "#/$defs/LayoutMode"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A world: `worlds/<slug>/world.json` plus its levels.",
  "properties": {
    "$schema": {
      "description": "Relative path to schema/world.json.",
      "type": "string"
    },
    "format": {
      "const": 1,
      "description": "File format version."
    },
    "guide_groups": {
      "description": "Named sets of guides, each with an offset, in insertion order.",
      "items": {
        "$ref": "#/$defs/GuideGroup"
      },
      "type": "array"
    },
    "layout": {
      "$ref": "#/$defs/WorldLayout",
      "description": "How the tools place the levels (free, a strip, a lattice). Left out\nat its default (free)."
    },
    "levels": {
      "description": "`levels`: the level order, by slug (the Levels pane, PgUp/PgDn, the\nexport and strip layouts follow it). Optional: left out, levels are\nin slug order. A level it doesn't list comes after the listed ones\n(in slug order), and validation reports it; so does a listed slug\nwith no level. `reorder_levels` writes it.",
      "items": {
        "$ref": "#/$defs/Slug"
      },
      "type": "array"
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "description": "World-scope annotations (world pixel coordinates), in insertion order.",
      "items": {
        "$ref": "#/$defs/Annotation"
      },
      "type": "array"
    },
    "references": {
      "description": "World-scope reference images (world pixels), bottom first. Never\nexported.",
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "type": "array"
    },
    "slug": {
      "$ref": "#/$defs/Slug",
      "description": "Same as the directory name."
    }
  },
  "required": [
    "$schema",
    "format",
    "slug"
  ],
  "title": "Worlds world file",
  "type": "object"
}
