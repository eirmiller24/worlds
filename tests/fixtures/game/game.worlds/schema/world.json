        {
          "additionalProperties": false,
          "properties": {
            "body": {
              "description": "Markdown.",
              "type": [
                "string",
                "null"
              ]
            },
            "color": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Color"
                },
                {
                  "type": "null"
                }
              ]
            },
            "export": {
              "description": "Included in `export/` for the game.",
              "type": "boolean"
