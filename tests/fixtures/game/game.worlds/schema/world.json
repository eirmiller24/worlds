                  "$ref": "#/$defs/Endpoint"
                },
                {
                  "type": "null"
                }
              ],
              "description": "connector (required): where it ends, as `from`."
            },
            "waypoints": {
              "description": "connector: points the line passes through between its ends,\n`[[x, y], ...]` in pixels.",
              "items": {
                "items": {
                  "format": "int64",
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
