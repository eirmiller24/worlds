                  "$ref": "#/$defs/Endpoint"
                },
                {
                  "type": "null"
                }
              ],
              "description": "connector (required): where it starts, `{ \"level\": slug }` or\n`{ \"entity\": id }`."
            },
            "id": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "connector"
            },
            "label": {
              "description": "pin: short label drawn next to the icon. connector: text drawn\nalong the line (\"needs double jump\").",
              "type": [
                "string",
                "null"
              ]
            },
            "links": {
              "description": "`level:<slug>`, `entity:<id>`, `note:<id>`, or a URL.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "locked": {
              "description": "Not movable in the editor.",
              "type": "boolean"
