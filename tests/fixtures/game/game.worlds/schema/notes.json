    "Color": {
      "description": "Hex color, #rrggbb or #rrggbbaa.",
      "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
      "type": "string"
    },
    "Id": {
      "description": "Instance id: 10 characters from a-z and 2-7.",
      "pattern": "^[a-z2-7]{10}$",
      "type": "string"
    },
    "KindTag": {
      "enum": [
        "note",
        "pin",
        "path",
        "region",
        "guide"
      ],
      "type": "string"
    },
    "NoteStatus": {
      "enum": [
        "open",
        "done"
      ],
      "type": "string"
    },
    "Slug": {
      "description": "snake_case name: a lowercase letter, then lowercase letters, digits or underscores.",
      "pattern": "^[a-z][a-z0-9_]*$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Body of a level's `notes.json`.",
  "properties": {
    "$schema": {
      "description": "Relative path to schema/notes.json.",
      "type": "string"
    },
    "format": {
      "const": 1,
      "description": "File format version."
    },
    "notes": {
      "items": {
        "$ref": "#/$defs/Annotation"
      },
      "type": "array"
    }
  },
  "required": [
    "$schema",
    "format",
    "notes"
  ],
  "title": "Worlds notes file",
  "type": "object"
}
