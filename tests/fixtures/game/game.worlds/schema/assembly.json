        {
          "additionalProperties": false,
          "properties": {
            "body": {
              "description": "Markdown.",
              "type": [
                "string",
                "null"
              ]
            },
            "color": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Color"
                },
                {
                  "type": "null"
                }
              ]
            },
            "export": {
              "description": "Included in `export/` for the game.",
              "type": "boolean"
            },
            "id": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "note"
            },
            "links": {
              "description": "`level:<slug>`, `entity:<id>`, `note:<id>`, or a URL.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "locked": {
              "description": "Not movable in the editor.",
              "type": "boolean"
            },
            "px": {
              "description": "note, pin (required): the point, in pixels.",
              "items": {
                "format": "int64",
                "type": "integer"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": [
                "array",
                "null"
              ]
            },
            "status": {
              "$ref": "#/$defs/NoteStatus"
            },
            "tags": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "kind",
            "px"
          ],
          "title": "note",
          "type": "object"
        },
        {
