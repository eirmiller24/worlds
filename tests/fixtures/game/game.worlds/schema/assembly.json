            "export": {
              "description": "Included in `export/` for the game.",
              "type": "boolean"
            },
            "group": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Slug"
                },
                {
                  "type": "null"
                }
              ],
              "description": "guide: the `world.json` guide group it belongs to."
            },
            "id": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "guide"
            },
            "links": {
              "description": "`level:<slug>`, `entity:<id>`, `note:<id>`, or a URL.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "locked": {
              "description": "Not movable in the editor.",
              "type": "boolean"
            },
            "points": {
              "description": "path, guide (2+), region polygon (3+): `[[x, y], ...]` in pixels.",
              "items": {
                "items": {
                  "format": "int64",
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "type": "array"
            },
            "status": {
