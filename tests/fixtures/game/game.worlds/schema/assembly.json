                "null"
              ]
            }
          },
          "required": [
            "id",
            "kind"
          ],
          "title": "region",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "body": {
              "description": "Markdown.",
              "type": [
                "string",
                "null"
              ]
            },
            "closed": {
              "description": "guide: join the last point back to the first.",
              "type": "boolean"
            },
            "color": {
