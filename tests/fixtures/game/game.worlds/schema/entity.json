    "FieldDisplay": {
      "additionalProperties": false,
      "description": "Where the editor shows a field's value.",
      "properties": {
        "arrow": {
          "description": "entity_ref and point: draw an arrow to the target.",
          "type": "boolean"
        },
        "canvas": {
          "description": "Show the value next to the entity on the canvas.",
          "type": "boolean"
        },
        "world": {
          "description": "Show in the zoomed-out world view.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Limit": {
      "additionalProperties": false,
      "description": "Instance count limit.",
      "properties": {
        "behavior": {
          "$ref": "#/$defs/LimitBehavior"
        },
        "max": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/LimitScope"
        }
      },
      "required": [
        "max"
      ],
      "type": "object"
    },
    "LimitBehavior": {
      "description": "What the editor does when a new instance would exceed the limit.",
      "enum": [
        "prevent_adding",
        "discard_oldest",
        "move_last_one"
      ],
      "type": "string"
    },
    "LimitScope": {
      "oneOf": [
        {
          "enum": [
            "level"
          ],
          "type": "string"
        },
        {
          "const": "layer",
          "description": "Per layer per level.",
          "type": "string"
        },
        {
          "const": "world",
          "description": "Across the whole project.",
          "type": "string"
        }
      ]
    },
    "Slug": {
      "description": "snake_case name: a lowercase letter, then lowercase letters, digits or underscores.",
      "pattern": "^[a-z][a-z0-9_]*$",
      "type": "string"
    },
    "TileRef": {
      "additionalProperties": false,
      "description": "One tile of a tileset, addressed by atlas column and row.",
      "properties": {
        "tile": {
          "description": "`[column, row]` in the tileset atlas.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "tileset": {
          "$ref": "#/$defs/Slug",
          "description": "Tileset slug."
        }
      },
      "required": [
        "tileset",
        "tile"
      ],
      "type": "object"
    },
