  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One entity type, one file: `entities/<slug>.json`.",
  "properties": {
    "$schema": {
      "description": "Relative path to schema/entity.json.",
      "type": "string"
    },
    "category": {
      "description": "`/`-separated palette path, e.g. `Puzzle/Doors`.",
      "type": [
        "string",
        "null"
      ]
    },
    "color": {
      "$ref": "#/$defs/Color"
    },
    "doc": {
      "type": [
        "string",
        "null"
      ]
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/FieldDef"
      },
      "type": "array"
    },
    "format": {
      "const": 1,
      "description": "File format version."
    },
    "icon": {
      "anyOf": [
        {
          "$ref": "#/$defs/TileRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "limit": {
      "anyOf": [
        {
          "$ref": "#/$defs/Limit"
        },
        {
          "type": "null"
        }
      ],
      "description": "Maximum instance count, or none for unlimited."
    },
    "name": {
      "type": "string"
    },
    "pivot": {
      "description": "Anchor inside the box, 0 to 1 on each axis. `[0.5, 1.0]` is bottom center. Default `[0, 0]`.",
      "items": {
        "format": "double",
        "type": "number"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "resizable": {
      "description": "Whether width and height can be changed per instance. Default `[false, false]`.",
      "items": {
        "type": "boolean"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "size": {
      "description": "`[width, height]` in cells of the project grid.",
      "items": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "slug": {
      "$ref": "#/$defs/Slug"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "$schema",
    "format",
    "slug",
    "name",
    "size",
    "color"
  ],
  "title": "Worlds entity file",
  "type": "object"
}
